{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "brief": {
      "type": "text"
    },
    "content": {
      "type": "richtext"
    },
    "author": {
      "type": "string"
    },
    "publishedDate": {
      "type": "string"
    },
    "readTime": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "likes": {
      "type": "integer",
      "default": 0
    },
    "tags": {
      "type": "json"
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
